# 環境変数の名前だけを書く。値はここに書かない（.claude/rules/security.md、NFR-40）。
# 置き場所と用途は docs/design/03_data_pipeline.md §16、docs/design/06_security.md §3。

# --- GitHub Actions の Secrets（日次バッチ） ---
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=
GA4_PROPERTY_ID=
SUPABASE_BATCH_DB_URL=
VERCEL_DEPLOY_HOOK_URL=

# --- Vercel の環境変数（BI のビルド時。NEXT_PUBLIC_ を付けない） ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- ローカル開発（supabase start のときの batch_writer のパスワード） ---
LOCAL_BATCH_WRITER_PASSWORD=
# 結合テスト（apps/batch/tests/db、tests/integration）の接続先。ローカルの Supabase だけを指す。
# 結合テストは内部表を空にするので、本番の値を書かない（ローカル以外ならテストが止まる）
DATABASE_URL=
SUPABASE_LOCAL_API_URL=
SUPABASE_LOCAL_ANON_KEY=

# --- 任意（試験・再実行） ---
# BASE_DATE=
