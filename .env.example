# 環境変数の名前だけを書く。値はここに書かない（.claude/rules/security.md、NFR-40）。
# 置き場所と用途は docs/design/03_data_pipeline.md §16、docs/design/06_security.md §3、docs/operations/environments.md §3。
# 形は 07 S-15 のとおり「名前=」だけ。.github/scripts/check_repo_rules.py が CI で一覧と突き合わせる。

# --- GitHub Actions のリポジトリの Secrets（日次バッチ、wif-check） ---
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=
GA4_PROPERTY_ID=

# --- GitHub Environment「production」（main だけ）の Secrets。リポジトリの Secret に置かない（ADR 0009 W-3） ---
SUPABASE_BATCH_DB_URL=
VERCEL_DEPLOY_HOOK_URL=

# --- Vercel の環境変数（BI のビルド時。NEXT_PUBLIC_ を付けない） ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- ローカル開発（supabase start のときの batch_writer のパスワード。CI はジョブの中で生成する） ---
LOCAL_BATCH_WRITER_PASSWORD=
# 結合テスト（apps/batch/tests/db、tests/integration）の接続先。ローカルの Supabase だけを指す。
# 結合テストは内部表を空にするので、本番の値を書かない（ローカル以外ならテストが止まる）
DATABASE_URL=
SUPABASE_LOCAL_API_URL=
SUPABASE_LOCAL_ANON_KEY=

# --- 任意（試験・再実行。daily.yml では workflow_dispatch の base_date から渡る） ---
# BASE_DATE=

# GitHub のリポジトリの Variable（秘密ではない。.env には書かない）: DAILY_ENABLED（'true' のときだけ daily.yml が動く）
