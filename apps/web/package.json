{
  "name": "takatsu-connect-analyzer-web",
  "version": "0.0.0",
  "private": true,
  "description": "高津コネクト アクセス解析 BI（Next.js App Router、静的生成）",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:env-names": "node scripts/check-public-env-names.mjs",
    "check:words": "node scripts/check-forbidden-words.mjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run check:env-names && pnpm run check:words",
    "check:build": "node scripts/check-build-output.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "e2e": "playwright test --project=chromium",
    "e2e:browsers": "playwright test --project=webkit --project=firefox",
    "e2e:stale": "node scripts/e2e-stale.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
